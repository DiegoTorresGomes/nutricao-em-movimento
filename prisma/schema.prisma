generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum PostStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum UserRole {
  ADMIN
  EDITOR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts Post[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[]
}

model Post {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  subtitle        String?
  description     String
  content         String     @db.LongText
  coverImageUrl   String?
  coverImage      String?
  coverImageAlt   String?
  status          PostStatus @default(DRAFT)
  language        String     @default("pt")
  readTime        String?
  views           Int        @default(0)
  isArticleOfWeek Boolean    @default(false)
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  contentBlocks   Json?
  seoTitle        String?
  seoDescription  String?
  focusKeyword    String?
  scheduledAt     DateTime?
  lastPreviewAt   DateTime?
  mobileReviewed  Boolean  @default(false)
  desktopReviewed Boolean  @default(false)
  tabletReviewed  Boolean  @default(false)

  authorId   String
  categoryId String

  author   User     @relation(fields: [authorId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
}

enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id                String           @id @default(cuid())
  name              String?
  email             String           @unique
  active            Boolean          @default(true)
  // Defaults to CONFIRMED so existing rows are backfilled as already opted-in;
  // new double opt-in sign-ups explicitly set PENDING until the e-mail is confirmed.
  status              SubscriberStatus @default(CONFIRMED)
  confirmationToken   String?          @unique
  confirmationExpiresAt DateTime?
  confirmedAt         DateTime?
  ipAddress           String?
  createdAt           DateTime         @default(now())

  // LGPD consent audit trail (filled on Double Opt-in confirmation).
  consentVersion       Int?
  consentAcceptedAt    DateTime?
  privacyPolicyVersion String?
  cookiesPolicyVersion String?
  userAgent            String?
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  // Opcionais: mensagens anteriores à Fase 2 não possuem estes dados — ficam
  // NULL (não inventamos assunto/telefone para registros legados).
  phone     String?
  subject   String?
  message   String   @db.LongText
  status    ContactMessageStatus @default(NEW)
  readAt    DateTime?
  createdAt DateTime @default(now())
  // @default(now()) garante backfill seguro dos registros existentes ao
  // adicionar a coluna; @updatedAt mantém o padrão do projeto nas atualizações.
  updatedAt DateTime @updatedAt @default(now())
}